     void parseData(const QByteArray &data)
     {
+        // First and cheapest: these arrive 25 times a second while head tracking runs.
+        if (data.size() > 60 && data.startsWith(AirPodsPackets::HeadTracking::DATA_HEADER))
+        {
+            const QByteArray line = data.toHex() + '\n';
+            for (const auto &client : std::as_const(m_headTrackSubscribers))
+                if (client) client->write(line);
+            return;
+        }
+
