     // The settings file holds the pairing keys, so keep it and its directory owner only.
+    // A client that sends "headtrack" gets every head-tracking frame as one hex line until it hangs up.
+    // The stream runs only while someone listens, so an idle daemon adds no Bluetooth traffic.
+    void addHeadTrackSubscriber(QLocalSocket *client)
+    {
+        m_headTrackSubscribers.append(client);
+        connect(client, &QLocalSocket::disconnected, this, [this, client]() {
+            m_headTrackSubscribers.removeAll(client);
+            m_headTrackSubscribers.removeAll(nullptr);
+            if (m_headTrackSubscribers.isEmpty())
+                writePacketToSocket(AirPodsPackets::HeadTracking::STOP, "Head tracking stop written: ");
+        });
+        if (m_headTrackSubscribers.size() == 1)
+            writePacketToSocket(AirPodsPackets::HeadTracking::START, "Head tracking start written: ");
+    }
